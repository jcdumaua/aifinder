        "deferred_rows",
        "manifest",
        "runner_children",
        "compiler_children"
      ],
      "properties": {
        "state": { "enum": ["PRE_RUNTIME", "RUNTIME_COMPLETE"] },
        "blockers_before": { "const": 7 },
        "blockers_after": { "type": "integer", "minimum": 0, "maximum": 7 },
        "runtime_validated_rows": { "type": "integer", "minimum": 0, "maximum": 7 },
        "matrix_entries": { "const": 69 },
