{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifinder.local/schemas/admin-v1-staging-runtime-evidence.schema.json",
  "title": "AiFinder Admin V1 staging authenticated runtime evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "lifecycle",
    "result",
    "authorization",
    "predecessor",
    "target",
    "preview",
    "protected_access",
    "environment",
    "runtime",
    "publication",
    "fixture",
    "cleanup",
    "governance",
    "repository",
    "safety",
    "storage_cleanup",
    "next"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "phase": { "const": "34IA-34IZ" },
    "lifecycle": {
      "enum": [
        "PRE_RUNTIME",
        "QUALIFICATION_COMPLETE_CLEANUP_PENDING",
        "QUALIFICATION_COMPLETE_CLEANUP_COMPLETE",
        "RUNTIME_EXECUTION_COMPLETE_CLEANUP_PENDING",
        "RUNTIME_COMPLETE"
      ]
    },
    "result": {
      "enum": [
        "PRE_RUNTIME_PENDING_AUTHENTICATED_RUNTIME",
        "PASSED_ADMIN_V1_STAGING_AUTHENTICATED_RUNTIME_CLOSURE"
      ]
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gemini_exact_approval_confirmed",
        "dynamic_target_confirmation",
        "confirmation_count",
        "approval_token_persisted"
      ],
      "properties": {
        "gemini_exact_approval_confirmed": { "const": true },
        "dynamic_target_confirmation": { "type": "boolean" },
        "confirmation_count": { "type": "integer", "minimum": 0, "maximum": 2 },
        "approval_token_persisted": { "const": false }
      }
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase_33na_passed",
        "phase_33na_final_dependency_evidence_ratified",
        "phase_33qa_unique_preview_trigger_validated",
        "phase_33ra_residual_preview_cleanup_passed",
        "phase_33sa_rolled_back_schema_incompatibility",
        "phase_33ta_failed_cleanup_resolver_exhaustion",
        "phase_33ua_residual_cleanup_passed",
        "phase_33va_marker_mismatch_rolled_back",
        "phase_34ba_phase_compiler_implemented",
        "phase_p01_compiler_proof_passed",
        "phase_34ea_bounded_inspection_contract_implemented",
        "phase_compiler_generation_exception_reviewed",
        "phase_compiler_policy_lane"
      ],
      "properties": {
        "phase_33na_passed": { "const": false },
        "phase_33na_final_dependency_evidence_ratified": { "const": true },
        "phase_33qa_unique_preview_trigger_validated": { "const": true },
        "phase_33ra_residual_preview_cleanup_passed": { "const": true },
        "phase_33sa_rolled_back_schema_incompatibility": { "const": true },
        "phase_33ta_failed_cleanup_resolver_exhaustion": { "const": true },
        "phase_33ua_residual_cleanup_passed": { "const": true },
        "phase_33va_marker_mismatch_rolled_back": { "const": true },
        "phase_34ba_phase_compiler_implemented": { "const": true },
        "phase_p01_compiler_proof_passed": { "const": true },
        "phase_34ea_bounded_inspection_contract_implemented": { "const": true },
        "phase_compiler_generation_exception_reviewed": { "const": true },
        "phase_compiler_policy_lane": { "const": "PASS_3_OF_3" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_target_sha256",
        "team_id_sha256",
        "project_id_sha256",
        "project",
        "environment",
        "branch",
        "baseline_commit",
        "marker_path",
        "marker_sha256",
        "marker_bytes",
        "marker_lf",
        "marker_cr",
        "marker_trailing_lf",
        "marker_mode",
        "supabase_project_ref_sha256",
        "supabase_origin_sha256"
      ],
      "properties": {
        "deployment_target_sha256": { "$ref": "#/$defs/hex64" },
        "team_id_sha256": { "$ref": "#/$defs/hex64" },
        "project_id_sha256": { "$ref": "#/$defs/hex64" },
        "project": { "const": "aifinder" },
        "environment": { "const": "preview" },
        "branch": { "const": "aifinder-phase-34ia-evidence-publication-runtime-validation-v3" },
        "baseline_commit": { "$ref": "#/$defs/git40" },
        "marker_path": { "const": "testing/aifinder-phase-34fa-staging-runtime-preview-marker.txt" },
        "marker_sha256": { "$ref": "#/$defs/hex64" },
        "marker_bytes": { "const": 475 },
        "marker_lf": { "const": 10 },
        "marker_cr": { "const": 0 },
        "marker_trailing_lf": { "const": true },
        "marker_mode": { "const": "100644" },
        "supabase_project_ref_sha256": { "$ref": "#/$defs/hex64" },
        "supabase_origin_sha256": { "$ref": "#/$defs/hex64" }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "branch_absence_checks",
        "branch_transaction_journal",
        "branch_transaction_mode",
        "marker_preworktree_proof",
        "temporary_worktrees_created",
        "temporary_worktrees_removed",
        "temporary_commits_created",
        "temporary_marker_files_created",
        "temporary_branch_create_pushes",
        "temporary_branch_delete_pushes",
        "deployments_created",
        "deployments_remaining",
        "rest_v13_identity",
        "deployment_id",
        "deployment_state_file_mode_0600",
        "delete_contract",
        "absence_checks",
        "owner_cleanup_fallbacks",
        "resume_state"
      ],
      "properties": {
        "state": { "enum": ["PENDING", "COMPLETE"] },
        "branch_absence_checks": { "type": "integer", "minimum": 0, "maximum": 2 },
        "branch_transaction_journal": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "attempt",
              "client_exit_class",
              "exact_ref_state",
              "external_mutation_possible",
              "live_may_continue",
              "operation",
              "retry_permitted",
              "sequence",
              "state"
            ],
            "properties": {
              "attempt": { "type": "integer", "minimum": 0, "maximum": 2 },
              "client_exit_class": {
                "enum": [
                  "NOT_SENT",
                  "NOT_OBSERVED",
                  "ZERO_EXACT",
                  "ZERO_UNCERTAIN",
                  "NONZERO_UNCERTAIN",
                  "SPAWN_ERROR"
                ]
              },
              "exact_ref_state": {
                "enum": ["NOT_READ", "ABSENT", "OURS", "OTHER", "MALFORMED"]
              },
              "external_mutation_possible": { "type": "boolean" },
              "live_may_continue": { "type": "boolean" },
              "operation": { "enum": ["CREATE", "DELETE"] },
              "retry_permitted": { "type": "boolean" },
              "sequence": { "type": "integer", "minimum": 1, "maximum": 32 },
              "state": {
                "enum": [
                  "INITIAL_REF_ABSENT",
                  "CREATE_REQUESTED",
                  "CREATE_RESULT_OBSERVED",
                  "CREATE_REF_ABSENT",
                  "CREATE_REF_OURS",
                  "CREATE_REF_OTHER",
                  "CREATE_CONFIRMED",
                  "DELETE_REQUESTED",
                  "DELETE_RESULT_OBSERVED",
                  "DELETE_REF_ABSENT",
                  "DELETE_REF_OURS",
                  "DELETE_REF_OTHER",
                  "DELETE_RETRY_REQUESTED",
                  "DELETE_CONFIRMED",
                  "CONFLICT_STOP",
                  "CLEANUP_FAILED"
                ]
              }
            }
          }
        },
        "branch_transaction_mode": {
          "enum": ["PENDING", "LIVE_TRANSACTION", "EXISTING_PREVIEW_RESUME"]
        },
        "marker_preworktree_proof": { "type": "boolean" },
        "temporary_worktrees_created": { "type": "integer", "minimum": 0, "maximum": 1 },
        "temporary_worktrees_removed": { "type": "integer", "minimum": 0, "maximum": 1 },
        "temporary_commits_created": { "type": "integer", "minimum": 0, "maximum": 2 },
        "temporary_marker_files_created": { "type": "integer", "minimum": 0, "maximum": 1 },
        "temporary_branch_create_pushes": { "type": "integer", "minimum": 0, "maximum": 2 },
        "temporary_branch_delete_pushes": { "type": "integer", "minimum": 0, "maximum": 2 },
        "deployments_created": { "type": "integer", "minimum": 0, "maximum": 8 },
        "deployments_remaining": { "type": "integer", "minimum": 0, "maximum": 8 },
        "rest_v13_identity": { "enum": ["PENDING", "PASS"] },
        "deployment_id": { "type": ["string", "null"], "pattern": "^dpl_[A-Za-z0-9]+$" },
        "deployment_state_file_mode_0600": { "type": "boolean" },
        "delete_contract": { "enum": ["PENDING", "REST_V13_DELETE_BY_ID_POSTSTATE_PASS", "VERCEL_CLI_REMOVE_EXACT_POSTSTATE_PASS"] },
        "absence_checks": { "type": "integer", "minimum": 0, "maximum": 2 },
        "owner_cleanup_fallbacks": { "const": 0 },
        "resume_state": {
          "enum": [null, "PREVIEW_BOUND_READY_BRANCH_CLEANED_PRE_RUNTIME"]
        }
      }
    },
    "protected_access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "access_mode",
        "credential_lifecycle_contract",
