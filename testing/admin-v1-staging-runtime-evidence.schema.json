        "credential_active_after_cleanup": { "type": "boolean" },
        "credential_cleanup_complete": { "type": "boolean" },
        "project_bypass_prestate": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "existing_bypass_record_count",
                "environment_designated_record_present",
                "trusted_sources_self_entry_present"
              ],
              "properties": {
                "existing_bypass_record_count": { "enum": ["ZERO", "ONE", "MULTIPLE"] },
                "environment_designated_record_present": { "type": "boolean" },
                "trusted_sources_self_entry_present": {
                  "enum": [true, false, "unknown"]
                }
              }
            }
          ]
        },
        "project_bypass_restored": { "type": "boolean" },
        "project_oidc_token_generations": { "type": "integer", "minimum": 0, "maximum": 4 },
        "protection_access_handshake_gets": { "type": "integer", "minimum": 0, "maximum": 6 },
        "temporary_bypass_cycles": { "type": "integer", "minimum": 0, "maximum": 3 },
        "header_qualification_application_requests": { "type": "integer", "minimum": 0, "maximum": 20 },
        "official_application_requests": { "type": "integer", "minimum": 0, "maximum": 20 },
        "raw_credential_material_persisted": { "const": 0 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "names",
        "metadata_names_present",
        "local_names_present",
        "sensitive_nonreadable_names",
        "optional_supabase_url_state",
        "metadata_requests",
        "pulls",
        "environment_value_reads",
        "global_preview_metadata_restored",
