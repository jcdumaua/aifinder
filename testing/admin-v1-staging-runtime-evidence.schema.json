      "properties": {
        "state": { "enum": ["PENDING", "PASS"] },
        "access_mode": {
          "enum": ["PENDING", "SELF_PROJECT_OIDC", "TEMPORARY_AUTOMATION_BYPASS"]
        },
        "credential_lifecycle_contract": {
          "enum": ["PENDING", "DELTA12_OIDC_EPHEMERAL_V1", "DELTA12_TEMPORARY_AUTOMATION_BYPASS_V1"]
