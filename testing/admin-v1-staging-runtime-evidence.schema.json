        "secret_hashes_persisted",
        "temporary_branch_override_absence_checks",
        "temporary_branch_overrides_created",
        "temporary_branch_overrides_remaining"
      ],
      "properties": {
        "state": { "enum": ["PENDING", "PASS"] },
        "names": { "$ref": "#/$defs/environmentNames" },
        "metadata_names_present": { "type": "integer", "minimum": 0, "maximum": 5 },
        "local_names_present": { "type": "integer", "minimum": 0, "maximum": 4 },
        "sensitive_nonreadable_names": { "type": "integer", "minimum": 0, "maximum": 5 },
        "optional_supabase_url_state": { "enum": ["PENDING", "ABSENT", "EFFECTIVE"] },
        "metadata_requests": { "type": "integer", "minimum": 0, "maximum": 2 },
        "pulls": { "const": 0 },
        "environment_value_reads": { "const": 0 },
        "global_preview_metadata_restored": { "type": "boolean" },
        "admin_password_runtime_proof": { "enum": ["PENDING", "PASS"] },
        "admin_session_secret_runtime_proof": { "enum": ["PENDING", "PASS"] },
        "raw_values_persisted": { "const": 0 },
        "secret_hashes_persisted": { "const": 0 },
        "temporary_branch_override_absence_checks": { "type": "integer", "minimum": 0, "maximum": 2 },
        "temporary_branch_overrides_created": { "type": "integer", "minimum": 0, "maximum": 2 },
        "temporary_branch_overrides_remaining": { "type": "integer", "minimum": 0, "maximum": 2 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "runtime_sessions",
        "application_requests",
        "runtime_retries",
        "runtime_routes",
        "runtime_methods",
        "request_ledger",
        "security_headers_passed",
        "session_cookie_contract",
        "csrf_contract",
        "fixture_binding",
        "logout_contract",
        "request8_input_sha256",
        "request8_has_terminal_slash",
        "request8_is_invalid_tld",
        "request9_expected_stored_sha256",
        "request9_expected_has_terminal_slash",
        "request9_unique_match_count",
        "request9_positive_tool_id",
        "canonical_relationship",
        "durable_projection_complete",
        "durable_projection_journal_sha256",
        "durable_projection_validated_requests",
        "input_and_stored_hashes_differ",
        "persisted_state_oracle_sha256",
        "poststate_projection_sha256",
        "projection_sufficiency",
        "projection_sufficiency_matrix_sha256",
        "sanitized_projection_revalidation_events"
      ],
      "properties": {
        "state": { "enum": ["PENDING", "PASS"] },
        "runtime_sessions": { "type": "integer", "minimum": 0, "maximum": 1 },
        "application_requests": { "type": "integer", "minimum": 0, "maximum": 20 },
        "runtime_retries": { "const": 0 },
        "runtime_routes": { "const": 7 },
        "runtime_methods": { "const": 13 },
        "request_ledger": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/requestRecord" }
        },
        "security_headers_passed": { "type": "integer", "minimum": 0, "maximum": 20 },
        "session_cookie_contract": { "enum": ["PENDING", "PASS"] },
        "csrf_contract": { "enum": ["PENDING", "PASS"] },
        "fixture_binding": { "enum": ["PENDING", "3_OF_3"] },
        "logout_contract": { "enum": ["PENDING", "PASS"] },
        "request8_input_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "request8_has_terminal_slash": { "type": ["boolean", "null"] },
        "request8_is_invalid_tld": { "type": ["boolean", "null"] },
        "request9_expected_stored_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "request9_expected_has_terminal_slash": { "type": ["boolean", "null"] },
        "request9_unique_match_count": { "type": "integer", "minimum": 0, "maximum": 1 },
        "request9_positive_tool_id": { "type": ["boolean", "null"] },
        "canonical_relationship": { "enum": ["PENDING", "APPLICATION_URL_TOSTRING_ROOT"] },
        "durable_projection_complete": { "type": "boolean" },
        "durable_projection_journal_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "durable_projection_validated_requests": { "type": "integer", "minimum": 0, "maximum": 20 },
        "input_and_stored_hashes_differ": { "type": ["boolean", "null"] },
        "persisted_state_oracle_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "poststate_projection_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "projection_sufficiency": { "enum": ["PENDING", "COMPLETE"] },
        "projection_sufficiency_matrix_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "sanitized_projection_revalidation_events": {
          "type": "array",
          "maxItems": 1,
          "items": { "$ref": "#/$defs/projectionRevalidationEvent" }
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle", "qualification", "runtime"],
