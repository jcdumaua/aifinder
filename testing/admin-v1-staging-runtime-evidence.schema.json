        "submitted_tool_fixtures": { "type": "integer", "minimum": 0, "maximum": 3 },
        "route_created_tools": { "type": "integer", "minimum": 0, "maximum": 1 },
        "approved_submission_tools": { "type": "integer", "minimum": 0, "maximum": 1 },
        "audit_actions": { "$ref": "#/$defs/auditActions" },
        "logo_objects": { "type": "integer", "minimum": 0, "maximum": 1 },
        "logo_payload_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "logo_payload_bytes": { "type": "integer", "minimum": 0, "maximum": 5242880 },
        "direct_rpc_executions": { "const": 0 },
        "route_rpc_executions": { "type": "integer", "minimum": 0, "maximum": 1 },
        "direct_data_success_requests": { "type": "integer", "minimum": 0, "maximum": 14 },
        "direct_data_total_requests": { "type": "integer", "minimum": 0, "maximum": 26 },
        "direct_data_maximum": { "const": 26 },
        "fixture_setup_retries": { "type": "integer", "minimum": 0, "maximum": 2 },
        "cleanup_retry_requests": { "type": "integer", "minimum": 0, "maximum": 2 }
