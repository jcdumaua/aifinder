        "raw_token_persisted",
        "delete_client_role",
        "service_role_delete_used",
        "request_method",
        "storage_operation",
        "CAS_outcome",
        "replacement_preserved",
        "grant_revoked",
        "post_delete_absence"
      ],
      "properties": {
        "storage_cleanup_mode": {
          "const": "RLS_EXPECTED_VERSION_CAPABILITY"
        },
        "grant_id_present": { "type": "boolean" },
        "expected_version_present": { "type": "boolean" },
        "token_hash_present": { "type": "boolean" },
        "raw_token_persisted": { "const": false },
        "delete_client_role": { "const": "anon" },
        "service_role_delete_used": { "const": false },
        "request_method": { "const": "DELETE" },
        "storage_operation": { "const": "storage.object.delete_many" },
        "CAS_outcome": {
          "enum": [
            "AUTHORIZED",
            "VERSION_MISMATCH",
            "EXPIRED",
            "DENIED",
            "AMBIGUOUS"
          ]
        },
        "replacement_preserved": {
          "enum": [true, false, "not_applicable"]
        },
        "grant_revoked": { "type": "boolean" },
        "post_delete_absence": { "type": "boolean" }
      }
    },
    "next": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_launch", "next_authority"],
      "properties": {
        "public_launch": { "const": "NO_GO" },
        "next_authority": {
          "const": "LEGAL_COMPLIANCE_POLICY_DESIGN_AND_FINAL_LAUNCH_READINESS_CONSOLIDATION"
        }
      }
    }
  },
  "$defs": {
    "hex64": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "git40": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "environmentNames": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        { "const": "ADMIN_PASSWORD" },
        { "const": "ADMIN_SESSION_SECRET" },
        { "const": "NEXT_PUBLIC_SUPABASE_ANON_KEY" },
        { "const": "NEXT_PUBLIC_SUPABASE_URL" },
        { "const": "SUPABASE_SERVICE_ROLE_KEY" }
      ],
      "items": false
    },
    "auditActions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": {
        "enum": [
          "tool_added",
          "tool_updated",
          "tool_deleted",
          "submission_updated",
          "submission_rejected",
          "submission_approved",
          "logo_uploaded",
          "admin_logout"
        ]
      }
    },
    "publicationLane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_count",
        "projection_complete",
        "cleanup_complete",
        "journal_retained",
        "cleanup_locators_retained"
      ],
      "properties": {
        "request_count": { "type": "integer", "minimum": 0, "maximum": 20 },
        "projection_complete": { "type": "boolean" },
        "cleanup_complete": { "type": "boolean" },
        "journal_retained": { "type": "boolean" },
        "cleanup_locators_retained": { "type": "boolean" }
      }
    },
    "requestRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "method",
        "path",
        "status",
        "contract",
        "security_headers",
        "raw_body_persisted",
        "raw_headers_persisted",
        "raw_url_persisted"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 20 },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string", "pattern": "^/api/admin/[a-z0-9/.-]+$" },
        "status": { "enum": [200, 401, 403, 404, 405] },
        "contract": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "security_headers": { "const": "PASS" },
        "raw_body_persisted": { "const": false },
        "raw_headers_persisted": { "const": false },
        "raw_url_persisted": { "const": false }
      }
    },
    "projectionRevalidationEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application_request_replay",
        "event",
        "original_error_code",
        "request_ordinal"
      ],
      "properties": {
        "application_request_replay": { "const": 0 },
        "event": { "const": "SANITIZED_PROJECTION_REVALIDATION" },
        "original_error_code": { "type": "string", "pattern": "^DELTA16A_[A-Z0-9_]{1,96}$" },
        "request_ordinal": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    }
  }
}
