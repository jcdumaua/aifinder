{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifinder.local/schemas/launch-operations-kernel-evidence-v1.json",
  "title": "AiFinder Launch Operations Kernel Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_identity_sha256",
    "lifecycle_state",
    "authorization_class",
    "budgets",
    "owned_resources",
    "effect_ledger",
    "cleanup",
    "recovery",
    "outcome",
    "immutable_audit_reference_sha256",
    "evidence_identity_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "candidate_identity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lifecycle_state": {
      "enum": [
        "READY",
        "QUALIFYING",
        "QUALIFIED",
        "OFFICIAL_RUNTIME_AUTHORIZED",
        "OFFICIAL_RUNTIME_RUNNING",
        "COMPLETE",
        "FAILED_RECOVERABLE",
        "FAILED_CLOSED"
      ]
    },
    "authorization_class": {
      "enum": [
        "NONE",
        "LOCAL_QUALIFICATION",
        "RECOVERY_CONTROLLER",
        "OFFICIAL_RUNTIME"
      ]
    },
    "budgets": { "$ref": "#/$defs/budgets" },
    "owned_resources": {
      "type": "array",
      "items": { "$ref": "#/$defs/owned_resource" }
    },
    "effect_ledger": {
      "type": "array",
      "items": { "$ref": "#/$defs/effect" }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "verified"],
      "properties": {
        "required": { "type": "boolean" },
        "verified": { "type": "boolean" }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "resume_to": { "type": "string", "minLength": 1 }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "successful"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "successful": { "type": "boolean" }
      }
    },
    "immutable_audit_reference_sha256": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "uniqueItems": true
    },
    "evidence_identity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "counter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "used"],
      "properties": {
        "limit": { "type": "integer", "minimum": 0 },
        "used": { "type": "integer", "minimum": 0 }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "mutations"],
      "properties": {
        "requests": { "$ref": "#/$defs/counter" },
        "mutations": { "$ref": "#/$defs/counter" }
      }
    },
    "owned_resource": {
      "oneOf": [
        { "$ref": "#/$defs/database_row" },
        { "$ref": "#/$defs/storage_object" },
        { "$ref": "#/$defs/preview_deployment" },
        { "$ref": "#/$defs/git_branch" },
        { "$ref": "#/$defs/environment_record" }
      ]
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "candidate_identity_sha256"],
      "properties": {
        "phase": { "const": "34JA-34JZ" },
        "candidate_identity_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "database_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_key", "resource_type", "owner", "locator"],
      "properties": {
        "resource_key": { "type": "string", "minLength": 1 },
        "resource_type": { "const": "DATABASE_ROW" },
        "owner": { "$ref": "#/$defs/owner" },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["relation", "id"],
          "properties": {
            "relation": { "type": "string", "minLength": 1 },
            "id": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "storage_object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_key",
        "resource_type",
        "owner",
        "locator",
        "storage_cas"
      ],
      "properties": {
        "resource_key": { "type": "string", "minLength": 1 },
        "resource_type": { "const": "STORAGE_OBJECT" },
        "owner": { "$ref": "#/$defs/owner" },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bucket", "name"],
          "properties": {
            "bucket": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        "storage_cas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expected_version", "delete_capability_sha256"],
          "properties": {
            "expected_version": { "type": "string", "minLength": 1 },
            "delete_capability_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "preview_deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_key", "resource_type", "owner", "locator"],
      "properties": {
        "resource_key": { "type": "string", "minLength": 1 },
        "resource_type": { "const": "PREVIEW_DEPLOYMENT" },
        "owner": { "$ref": "#/$defs/owner" },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deployment_id", "project_id"],
          "properties": {
            "deployment_id": { "type": "string", "minLength": 1 },
            "project_id": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "git_branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_key", "resource_type", "owner", "locator"],
      "properties": {
        "resource_key": { "type": "string", "minLength": 1 },
        "resource_type": { "const": "GIT_BRANCH" },
        "owner": { "$ref": "#/$defs/owner" },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "branch", "expected_commit_sha256"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "branch": { "type": "string", "minLength": 1 },
            "expected_commit_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "environment_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_key", "resource_type", "owner", "locator"],
      "properties": {
        "resource_key": { "type": "string", "minLength": 1 },
        "resource_type": { "const": "ENVIRONMENT_RECORD" },
        "owner": { "$ref": "#/$defs/owner" },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project_id", "key", "target"],
          "properties": {
            "project_id": { "type": "string", "minLength": 1 },
            "key": { "type": "string", "minLength": 1 },
            "target": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "resource_key", "effect", "status"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "resource_key": { "type": "string", "minLength": 1 },
        "effect": { "const": "CREATE" },
        "status": {
          "enum": ["INTENT_ONLY", "APPLIED", "UNCERTAIN", "CLEANED"]
        }
      }
    }
  }
}
