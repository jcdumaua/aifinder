              "required": ["key_name", "source_name"],
              "properties": {
                "key_name": { "const": "ADMIN_PASSWORD" },
                "source_name": { "const": "PROCESS_ENV_EXACT_KEY" }
              }
            },
            "provider_auth": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key_name", "source_name"],
              "properties": {
                "key_name": { "const": "token" },
                "source_name": { "const": "AVAILABLE_EXISTING_VERCEL_CLI_SOURCE" }
              }
            }
          }
        },
        "capability_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "credential_value_reads", "environment_creates",
            "environment_deletes", "environment_identity_reads",
            "environment_updates",
            "full_official_ledger", "git_writes", "replays", "retries",
            "second_invocations", "storage_rpc_actions", "supabase_reads",
