      "properties": {
        "root": { "const": "/Users/jamescarlodumaua/aifinder" },
        "branch": { "const": "main" },
        "head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "origin_main": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "remote_main": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "ahead": { "const": 0 },
        "behind": { "const": 0 },
        "index_empty": { "const": true },
        "worktree_count": { "const": 1 },
        "status_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
