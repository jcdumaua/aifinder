      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime_source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "supervisor_source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transport_source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authorization_schema_sha256": {
      "type": "string",
