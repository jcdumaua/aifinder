            "environment_creates": { "const": 1 },
            "environment_deletes": { "const": 0 },
            "environment_identity_reads": { "const": 0 },
            "environment_updates": { "const": 0 },
            "full_official_ledger": { "const": 0 },
            "git_writes": { "const": 0 },
            "replays": { "const": 0 },
            "retries": { "const": 0 },
            "second_invocations": { "const": 0 },
            "storage_rpc_actions": { "const": 0 },
            "supabase_reads": { "const": 0 },
            "supabase_writes": { "const": 0 }
