          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "credential_loader_source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "supervisor_policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "independent_semantic_pin_set_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "transport_dependency_source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
