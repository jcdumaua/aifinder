          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "gemini_approval_token_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
